# =========================================================
# Universo AGV — Landing Page environment template
# =========================================================
# This project runs on Lovable Cloud. The real .env file is
# generated and managed automatically — do NOT edit it.
# This file documents the variables the app expects so the
# project can be set up on any environment (Netlify, Vercel,
# local dev, self-host, etc.).
# =========================================================

# ---- Frontend (exposed to the browser, safe to commit) ----
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# ---- Server-side only (NEVER expose to the browser) ----
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ---- Optional analytics (set in production deploy) ----
# VITE_GA_MEASUREMENT_ID="G-XXXXXXX"
# VITE_META_PIXEL_ID="000000000000000"
